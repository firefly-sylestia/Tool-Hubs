{
  "name": "mc-launcher",
  "version": "0.14.0",
  "description": "Offline-only Minecraft launcher: instances with their own version, mods, resource packs and shader packs, modpack import and export, and offline-mode servers.",
  "license": "MIT",
  "author": {
    "name": "Mohammad Abdul Qadir Khan",
    "email": "khanquadir19@gmail.com"
  },
  "homepage": "https://github.com/firefly-sylestia/Tool-Hubs/tree/main/desktop/mc-launcher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firefly-sylestia/Tool-Hubs.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "netcheck": "tsx scripts/netcheck.ts",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run selfcheck && npm run test && electron-vite build",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "vuetify": "^4.2.5"
  }
}
