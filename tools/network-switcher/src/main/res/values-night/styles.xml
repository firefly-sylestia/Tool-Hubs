<resources>
    <!--
        Aurora night shell. Without this the manifest theme stayed on the light Material parent, so
        the window behind Compose flashed white on every cold start and rotation in dark mode.
    -->
    <style name="ToolHubsTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#080B11</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
